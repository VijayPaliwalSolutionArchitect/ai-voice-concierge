# ───────────────────────────────────────────────────────────────
# ai-voice-concierge — SHIVAM ITCS
# Root .editorconfig
#
# The repository mixes three languages today (markdown docs,
# YAML/JSON config, and whatever application code lands first).
# Without this file every contributor's IDE applies its own
# defaults, and formatting drift creeps into PRs for free.
# ───────────────────────────────────────────────────────────────

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# ── Code ────────────────────────────────────────────────────────
# C# / .NET convention is 4 spaces; Python and YAML/JSON use 2.
# Match the convention of each file type rather than imposing one
# global width.

[*.{cs,csx,csproj,sln}]
indent_size = 4

[*.{py,pyi}]
indent_size = 4

[*.{js,ts,jsx,tsx,mjs,cjs}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.{xml,config,props,targets}]
indent_size = 2

[*.{html,css,scss,less}]
indent_size = 2

[*.{sql,sh,bash,zsh}]
indent_size = 2

# ── Prose ───────────────────────────────────────────────────────
[*.md]
trim_trailing_whitespace = false
# Markdown trailing spaces are intentional (hard line breaks).

[*.txt]
indent_size = 2

# ── Generated / lock files ──────────────────────────────────────
[*.{lock,lock.json}]
indent_size = 2